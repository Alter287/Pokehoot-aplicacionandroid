<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_pokemon_gradient"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MULTIJUGADOR"
                android:textColor="#FFFFFFAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salas Online"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/pokemon_font"
                android:shadowColor="#CC000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Únete a una partida existente"
                android:textColor="#FFFFFFCC"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ESPACIO PARA HOOTHOOT -->
        <View
            android:layout_width="match_parent"
            android:layout_height="90dp" />

        <!-- BUSCADOR -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    app:tint="#9E9E9E" />

                <EditText
                    android:id="@+id/etCodigoSala"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar por código de sala"
                    android:paddingHorizontal="12dp"
                    android:textColor="#212121"
                    android:textColorHint="#9E9E9E"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/btnBuscarSala"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Entrar"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EE1515"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TEXTO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALAS DISPONIBLES"
            android:textColor="#FFFFFFAA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp" />

        <!-- LISTA -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSalas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="90dp" />

    </LinearLayout>

    <!-- HOOTHOOT -->
    <ImageView
        android:id="@+id/imgHoothoot"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:src="@drawable/hoothootinteligente"
        android:layout_gravity="top|end"
        android:layout_marginTop="45dp"
        android:translationX="15dp"
        android:translationY="10dp"
        android:elevation="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitEnd"
        android:contentDescription="" />

    <!-- BADGE ONLINE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_online_badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:elevation="8dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_circle_green"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSalasOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24 salas activas"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- POKEBOLA -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/pokeball"
        android:alpha="0.07"
        android:layout_gravity="top|start"
        android:translationX="-50dp"
        android:translationY="-50dp" />

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/pokeball"
        android:alpha="0.07"
        android:layout_gravity="bottom|start"
        android:translationX="-30dp"
        android:translationY="30dp" />

</FrameLayout>