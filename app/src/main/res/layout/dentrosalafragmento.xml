<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_pokemon_gradient"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SALA MULTIJUGADOR"
                android:textColor="#FFFFFFAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sala Johto"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/pokemon_font"
                android:shadowColor="#CC000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Esperando jugadores..."
                android:textColor="#FFFFFFCC"
                android:textSize="12sp" />

        </LinearLayout>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_online"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Código de sala"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCodigoSala"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKH-4821"
                        android:textColor="#212121"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnCopiarCodigo"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Copiar"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EE1515"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JUGADORES"
            android:textColor="#FFFFFFAA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerJugadores"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSalirSala"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Salir"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#616161"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnEmpezar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Empezar"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EE1515"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/countdownOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC000000">

        <View
            android:id="@+id/circleBackground"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_countdown_circle"
            android:translationX="-5dp"
            android:translationY="-19dp"/>

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="80sp"
            android:textStyle="bold"
            android:fontFamily="@font/pokemon_font"
            android:shadowColor="#CC000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="100dp"
            android:text="¡Prepárate!"
            android:textColor="#FFFFFFCC"
            android:textSize="18sp"
            android:textStyle="bold" />

    </FrameLayout>

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/pokeball"
        android:alpha="0.07"
        android:layout_gravity="top|start"
        android:translationX="-50dp"
        android:translationY="-50dp" />

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/pokeball"
        android:alpha="0.07"
        android:layout_gravity="bottom|start"
        android:translationX="-30dp"
        android:translationY="30dp" />

</FrameLayout>